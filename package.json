{
  "name": "personal-project-planner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:ui": "playwright test --project=ui",
    "test:e2e": "playwright test --project=e2e",
    "test": "npm run test:unit && npm run test:api",
    "build": "tsx scripts/build.ts",
    "make:win": "cd apps/desktop && electron-forge make --platform=win32 --arch=x64",
    "services": "tsx scripts/test-services.ts",
    "dev:api": "tsx apps/api/src/start.ts",
    "dev:ui": "tsx tests/support/web-harness.ts",
    "dev:desktop": "cd apps/desktop && electron-forge start"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/plugin-webpack": "8.0.1",
    "@playwright/test": "1.64.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "css-loader": "^7.1.0",
    "electron": "44.7.0",
    "electron-squirrel-startup": "^1.0.1",
    "html-webpack-plugin": "^5.6.0",
    "prettier": "3.9.10",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.3",
    "webpack": "5.111.1",
    "webpack-cli": "^6.0.0",
    "webpack-dev-server": "^5.2.0"
  },
  "type": "module"
}
